              "id": "CVE-2026-82049",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "python: Python tarfile module: File modification and content disclosure via crafted archives"
              },
              "fullDescription": {
                "text": "In CPython 3.13 and earlier, the tarfile module's data and tar extraction filters are vulnerable to crafted archives containing a hard link to a symbolic link. Such archives may cause extraction to modify the permissions or modification time of a file outside the destination directory, or expose the contents of that file within the extracted tree."
              },
              "defaultConfiguration": {
